    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-router-dom": "^7.10.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.0"
  }
